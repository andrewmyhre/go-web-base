apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: [[ test_namespace ]]
spec:
  replicas: 1
  strategy: { type: Recreate }
  selector: { matchLabels: { app: postgres } }
  template:
    metadata: { labels: { app: postgres } }
    spec:
      containers:
        - name: postgres
          image: postgres:18.6-alpine
          env:
            - { name: POSTGRES_USER, value: [[ ident ]] }
            - { name: POSTGRES_DB, value: [[ ident ]]_test }
            - name: POSTGRES_PASSWORD
              valueFrom: { secretKeyRef: { name: test-services, key: password } }
            - { name: PGDATA, value: /var/lib/postgresql/data/pgdata }
          ports: [{ containerPort: 5432 }]
          readinessProbe:
            exec: { command: ["pg_isready", "-U", "[[ ident ]]", "-d", "[[ ident ]]_test"] }
            periodSeconds: 5
          resources:
            requests: { cpu: 100m, memory: 256Mi }
            limits: { cpu: "1", memory: 1Gi }
          volumeMounts: [{ name: data, mountPath: /var/lib/postgresql/data }]
      volumes: [{ name: data, emptyDir: {} }]
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: [[ test_namespace ]]
spec:
  type: NodePort
  selector: { app: postgres }
  ports: [{ port: 5432, targetPort: 5432, nodePort: [[ test_postgres_nodeport ]] }]
