{
  "components": {
    "schemas": {
      "CreateInviteInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "The address to invite. Its first sign-in with this Google-verified address is let in.",
            "maxLength": 254,
            "minLength": 3,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HealthOutputBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "Always ok while the server is serving.",
            "examples": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "InviteBody": {
        "additionalProperties": false,
        "properties": {
          "consumed_at": {
            "format": "date-time",
            "type": "string"
          },
          "consumed_by": {
            "description": "The account id that used it.",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "created_by": {
            "description": "Who created it (an account id).",
            "type": "string"
          },
          "email": {
            "description": "The invited address, lower case.",
            "type": "string"
          },
          "id": {
            "description": "The invite's id.",
            "format": "int64",
            "type": "integer"
          },
          "revoked_at": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "description": "pending can still be used; revoked was withdrawn; consumed admitted a first sign-in.",
            "enum": [
              "pending",
              "revoked",
              "consumed"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "status",
          "created_at"
        ],
        "type": "object"
      },
      "ListInvitesOutputBody": {
        "additionalProperties": false,
        "properties": {
          "invites": {
            "description": "Every invite, newest first.",
            "items": {
              "$ref": "#/components/schemas/InviteBody"
            },
            "type": "array"
          }
        },
        "required": [
          "invites"
        ],
        "type": "object"
      },
      "ListSettingsOutputBody": {
        "additionalProperties": false,
        "properties": {
          "settings": {
            "items": {
              "$ref": "#/components/schemas/SettingBody"
            },
            "type": "array"
          }
        },
        "required": [
          "settings"
        ],
        "type": "object"
      },
      "MeOutputBody": {
        "additionalProperties": false,
        "properties": {
          "avatar": {
            "description": "Avatar URL.",
            "type": "string"
          },
          "email": {
            "description": "Email, shown only and never matched on. Empty unless Google says it is verified.",
            "type": "string"
          },
          "id": {
            "description": "Google account ID (the OIDC sub). This is the identity.",
            "type": "string"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "roles": {
            "description": "Every role the user is bound to, in every domain, read from the role bindings. Sorted by domain, then role.",
            "items": {
              "$ref": "#/components/schemas/MeRole"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "avatar",
          "roles"
        ],
        "type": "object"
      },
      "MeRole": {
        "additionalProperties": false,
        "properties": {
          "domain": {
            "description": "Where the binding applies: global, or a project ID.",
            "type": "string"
          },
          "role": {
            "description": "Role name, for example Admin.",
            "type": "string"
          }
        },
        "required": [
          "role",
          "domain"
        ],
        "type": "object"
      },
      "SettingBody": {
        "additionalProperties": false,
        "properties": {
          "default": {
            "description": "The value when nobody has set one.",
            "type": "string"
          },
          "description": {
            "description": "What the setting does.",
            "type": "string"
          },
          "key": {
            "description": "The setting's key.",
            "type": "string"
          },
          "label": {
            "description": "A short name for display.",
            "type": "string"
          },
          "options": {
            "description": "The values the setting allows.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "updated_at": {
            "description": "When an admin last changed it. Absent while it is at its default.",
            "format": "date-time",
            "type": "string"
          },
          "updated_by": {
            "description": "Who last changed it (an account id).",
            "type": "string"
          },
          "value": {
            "description": "The current value.",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "description",
          "options",
          "value",
          "default"
        ],
        "type": "object"
      },
      "UpdateSettingInputBody": {
        "additionalProperties": false,
        "properties": {
          "value": {
            "description": "The new value; it must be one of the setting's options.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "goldenapp",
    "version": "9.9.9"
  },
  "openapi": "3.1.0",
  "paths": {
    "/account": {
      "get": {
        "operationId": "get-account",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "account"
      }
    },
    "/admin/invites": {
      "get": {
        "operationId": "list-site-invites",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListInvitesOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the sign-up invites",
        "tags": [
          "admin"
        ]
      },
      "post": {
        "description": "Core sends no email: share the site's sign-in link with the person.",
        "operationId": "create-site-invite",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInviteInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Invite an email address",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/invites/{id}": {
      "delete": {
        "operationId": "revoke-site-invite",
        "parameters": [
          {
            "description": "The invite's id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "The invite's id.",
              "format": "int64",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Revoke a pending invite",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/settings": {
      "get": {
        "operationId": "list-site-settings",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListSettingsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List the site settings",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/settings/{key}": {
      "put": {
        "operationId": "update-site-setting",
        "parameters": [
          {
            "description": "The setting's key.",
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "description": "The setting's key.",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSettingInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Change a site setting",
        "tags": [
          "admin"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "auth-logout",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "description": "Clears the session cookie.",
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "End the session",
        "tags": [
          "auth"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "get-health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Report that the server is serving",
        "tags": [
          "server"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "get-me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Return the signed-in user",
        "tags": [
          "auth"
        ]
      }
    },
    "/projects": {
      "get": {
        "operationId": "list-projects",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "list-projects"
      },
      "post": {
        "operationId": "create-project",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "create-project"
      }
    },
    "/projects/{id}": {
      "delete": {
        "operationId": "delete-project",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "delete-project"
      }
    },
    "/widgets": {
      "get": {
        "operationId": "list-widgets",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "List widgets",
        "tags": [
          "widgets"
        ]
      }
    }
  }
}
