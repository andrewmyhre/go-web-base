// The property that distinguishes the [[ project_slug ]] API: a route without a
// declared permission is refused at startup, so the server cannot serve it.
func TestServerRefusesToStartRouteWithoutPermission(t *testing.T) {
	router := newTestRouter()
	// Bypass Register so the router holds a route with no permission:
	// startup itself must refuse it.
	router.regs = append(router.regs, registration{
		method: http.MethodGet,
		path:   "/open",
		mount:  func(huma.API, chi.Router, *guard) {},
	})

	srv := New(config.Default(), zap.NewNop(), router)

	if _, err := srv.Handler(); !errors.Is(err, ErrNoPermission) {
		t.Fatalf("Handler() error = %v, want ErrNoPermission", err)
	}
	if err := srv.Start(context.Background()); !errors.Is(err, ErrNoPermission) {
		t.Fatalf("Start() error = %v, want ErrNoPermission", err)
	}
}

func TestServerStartsAndServesRoutes(t *testing.T) {
	router := newTestRouter()
	if err := Register(router, op(http.MethodGet, "/health", Public), okHandler); err != nil {
		t.Fatalf("Register: %v", err)
	}

	handler, err := New(config.Default(), zap.NewNop(), router).Handler()
	if err != nil {
		t.Fatalf("Handler: %v", err)
	}
	if rec := serve(t, handler, http.MethodGet, "/health"); rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want %d", rec.Code, http.StatusOK)
	}
}
