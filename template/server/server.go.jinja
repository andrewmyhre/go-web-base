package server

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"time"

	"go.uber.org/zap"

	"[[ go_module ]]/config"
)

// Server is the [[ project_slug ]] HTTP API server.
type Server struct {
	cfg    config.Config
	log    *zap.Logger
	router *Router
}

// New creates a server that serves the routes registered on router, using
// the given configuration and logger.
func New(cfg config.Config, log *zap.Logger, router *Router) *Server {
	return &Server{cfg: cfg, log: log, router: router}
}

// Handler builds the HTTP handler the server will serve. This is the
// startup gate: it refuses to build, returning an error, if any registered
// route lacks a declared permission, so an unprotected route can never be
// served.
func (s *Server) Handler() (http.Handler, error) {
	handler, err := s.router.Build(s.log)
	if err != nil {
		return nil, fmt.Errorf("start server: %w", err)
	}
	return handler, nil
}

// Start serves the API on cfg.Addr until ctx is cancelled, then shuts the
// server down. It refuses to start if any route lacks a declared
// permission.
func (s *Server) Start(ctx context.Context) error {
	handler, err := s.Handler()
	if err != nil {
		return err
	}

	srv := &http.Server{
		Addr:              s.cfg.Addr,
		Handler:           handler,
		ReadHeaderTimeout: 5 * time.Second,
		ErrorLog:          zap.NewStdLog(s.log.Named("http")),
	}

	errCh := make(chan error, 1)
	go func() {
		s.log.Info("server starting", zap.String("addr", s.cfg.Addr))
		errCh <- srv.ListenAndServe()
	}()

	select {
	case err := <-errCh:
		return err
	case <-ctx.Done():
	}

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := srv.Shutdown(shutdownCtx); err != nil {
		return err
	}
	if err := <-errCh; !errors.Is(err, http.ErrServerClosed) {
		return err
	}
	s.log.Info("server stopped")
	return nil
}
