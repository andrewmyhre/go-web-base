// The integration tests below run sign-in against the real test Postgres
// (role bindings, through the Casbin enforcer) and the real test Redis
// (sessions and attempts), so the gate is checked over the stores
// production uses. Both must be configured: unset fails rather than skips
// (deploy/test-services/README.md).

// testEnforcer migrates a fresh schema in the test Postgres and returns
// the RBAC enforcer over it, with adminSub bootstrapped as the global
// Admin. The schema is dropped when the test ends.
func testEnforcer(t *testing.T, adminSub string) *casbin.Enforcer {
	t.Helper()
	ctx := context.Background()
	if os.Getenv("[[ env_prefix ]]_SKIP_SERVICE_TESTS") == "1" {
		t.Skip("[[ env_prefix ]]_SKIP_SERVICE_TESTS=1: skipping a test that needs the test Postgres")
	}
	dsn := os.Getenv("[[ env_prefix ]]_TEST_DATABASE_URL")
	if dsn == "" {
		t.Fatal("[[ env_prefix ]]_TEST_DATABASE_URL is not set; see deploy/test-services/README.md")
	}
	id, err := randomHex(8)
	if err != nil {
		t.Fatal(err)
	}
	schema := pgx.Identifier{"t_" + id}.Sanitize()
	admin, err := pgx.Connect(ctx, dsn)
	if err != nil {
		t.Fatalf("connect to test database: %v", err)
	}
	defer func() { _ = admin.Close(ctx) }()
	if _, err := admin.Exec(ctx, "CREATE SCHEMA "+schema); err != nil {
		t.Fatalf("create schema: %v", err)
	}
	t.Cleanup(func() {
		conn, err := pgx.Connect(context.Background(), dsn)
		if err != nil {
			t.Errorf("connect to drop schema: %v", err)
			return
		}
		defer func() { _ = conn.Close(context.Background()) }()
		if _, err := conn.Exec(context.Background(), "DROP SCHEMA "+schema+" CASCADE"); err != nil {
			t.Errorf("drop schema: %v", err)
		}
	})
	cfg, err := pgxpool.ParseConfig(dsn)
	if err != nil {
		t.Fatal(err)
	}
	cfg.ConnConfig.RuntimeParams["search_path"] = "t_" + id
	if err := db.MigrateWithConfig(ctx, cfg.ConnConfig); err != nil {
		t.Fatalf("migrate: %v", err)
	}
	pool, err := db.NewWithConfig(ctx, cfg)
	if err != nil {
		t.Fatalf("open pool: %v", err)
	}
	t.Cleanup(pool.Close)
	e, err := db.NewEnforcer(ctx, pool, adminSub)
	if err != nil {
		t.Fatalf("NewEnforcer: %v", err)
	}
	return e
}

// testRedis connects to the test Redis and returns the client and a unique
// key prefix for this test.
func testRedis(t *testing.T) (*goredis.Client, string) {
	t.Helper()
	if os.Getenv("[[ env_prefix ]]_SKIP_SERVICE_TESTS") == "1" {
		t.Skip("[[ env_prefix ]]_SKIP_SERVICE_TESTS=1: skipping a test that needs the test Redis")
	}
	addr := os.Getenv("[[ env_prefix ]]_TEST_REDIS_ADDR")
	if addr == "" {
		t.Fatal("[[ env_prefix ]]_TEST_REDIS_ADDR is not set; see deploy/test-services/README.md")
	}
	client, err := redis.NewClient(context.Background(), redis.Config{Addr: addr, Password: os.Getenv("[[ env_prefix ]]_TEST_REDIS_PASSWORD")})
	if err != nil {
		t.Fatalf("connect to test redis: %v", err)
	}
	t.Cleanup(func() { _ = client.Close() })
	id, err := randomHex(8)
	if err != nil {
		t.Fatal(err)
	}
	return client, "[[ project_slug ]]:test:" + id + ":"
}

// integrationRig is sign-in, /me and a role route (Projects Read, decided
// in the global domain like every role route today) over the real stores.
type integrationRig struct {
	google   *fakeGoogle
	enforcer *casbin.Enforcer
	redis    *goredis.Client
	prefix   string
	sessions *redis.Store
	h        http.Handler
	logs     *bytes.Buffer
}

const integrationAdmin = "100000000000000000099"

func newIntegrationRig(t *testing.T) *integrationRig {
	t.Helper()
	client, prefix := testRedis(t)
	rig := &integrationRig{
		google:   newFakeGoogle(t),
		enforcer: testEnforcer(t, integrationAdmin),
		redis:    client,
		prefix:   prefix,
		sessions: redis.NewStore(client, prefix+"session:"),
		logs:     &bytes.Buffer{},
	}
	attempts := redis.NewStore(client, prefix+"signin:")
	g, err := NewGoogle(rig.google.config())
	if err != nil {
		t.Fatal(err)
	}
	authz := CasbinAuthorizer{Enforcer: rig.enforcer}
	log := bufferLogger(rig.logs)
	auth := NewAuth(g, rig.sessions, attempts, authz, log, fakeClientSecret)
	r := NewRouter("t", "0").WithAuth(rig.sessions, authz)
	if err := Register(r, op(http.MethodGet, "/me", Authenticated), NewMe(authz, log)); err != nil {
		t.Fatal(err)
	}
	if err := Register(r, op(http.MethodGet, "/projects", projectsRead), okHandler); err != nil {
		t.Fatal(err)
	}
	for _, x := range []struct {
		path string
		h    http.Handler
	}{{AuthStartPath, auth.Start()}, {AuthCallbackPath, auth.Callback()}} {
		if err := RegisterHandler(r, op(http.MethodGet, x.path, Public), x.h); err != nil {
			t.Fatal(err)
		}
	}
	if err := Register(r, op(http.MethodPost, LogoutPath, Public), auth.Logout); err != nil {
		t.Fatal(err)
	}
	rig.h = mustBuild(t, r, log)
	return rig
}

func (rig *integrationRig) do(method, target string, cookies ...*http.Cookie) *http.Response {
	sr := &signInRig{h: rig.h}
	return sr.do(method, target, cookies...).Result()
}

// sessionKeys counts the session keys this test has in Redis.
func (rig *integrationRig) sessionKeys(t *testing.T) int {
	t.Helper()
	keys, err := rig.redis.Keys(context.Background(), rig.prefix+"session:*").Result()
	if err != nil {
		t.Fatalf("list session keys: %v", err)
	}
	return len(keys)
}

// signIn runs the whole flow as sub and returns the callback's response.
func (rig *integrationRig) signIn(t *testing.T, sub string, cookies ...*http.Cookie) *http.Response {
	t.Helper()
	rig.google.claims = func(auth url.Values) map[string]any {
		c := map[string]any{
			"iss": rig.google.srv.URL, "aud": fakeClientID, "azp": fakeClientID, "sub": sub,
			"exp": 4102444800, "iat": 1700000000, "nonce": auth.Get("nonce"),
			"email": "person@example.com", "email_verified": true, "name": "Person",
		}
		return c
	}
	start := rig.do(http.MethodGet, AuthStartPath)
	if start.StatusCode != http.StatusFound {
		t.Fatalf("start = %d", start.StatusCode)
	}
	state, code := rig.google.authorize(start.Header.Get("Location"))
	var stateCookie *http.Cookie
	for _, c := range start.Cookies() {
		if c.Name == StateCookie {
			stateCookie = c
		}
	}
	callback := AuthCallbackPath + "?" + url.Values{"state": {state}, "code": {code}}.Encode()
	return rig.do(http.MethodGet, callback, append([]*http.Cookie{stateCookie}, cookies...)...)
}

func sessionCookieOf(res *http.Response) *http.Cookie {
	for _, c := range res.Cookies() {
		if c.Name == SessionCookie {
			return c
		}
	}
	return nil
}

// TestIntegrationUnboundUserIsRefused: with no binding in any domain, the
// callback answers 403 and Redis holds no session for this test, not even
// the one the browser had before.
func TestIntegrationUnboundUserIsRefused(t *testing.T) {
	rig := newIntegrationRig(t)
	// The browser already holds a valid session (the admin's).
	first := rig.signIn(t, integrationAdmin)
	old := sessionCookieOf(first)
	if first.StatusCode != http.StatusFound || old == nil || rig.sessionKeys(t) != 1 {
		t.Fatalf("admin sign-in = %d with cookie %v and %d keys, want 302, a cookie and 1 key", first.StatusCode, old, rig.sessionKeys(t))
	}

	res := rig.signIn(t, "100000000000000000777", old)
	if res.StatusCode != http.StatusForbidden {
		t.Fatalf("unbound callback = %d, want 403", res.StatusCode)
	}
	if c := sessionCookieOf(res); c == nil || c.MaxAge >= 0 {
		t.Fatalf("unbound callback session cookie = %v, want it cleared", c)
	}
	if n := rig.sessionKeys(t); n != 0 {
		t.Fatalf("redis holds %d session keys after the refusal, want 0", n)
	}
	if me := rig.do(http.MethodGet, "/me", old); me.StatusCode != http.StatusUnauthorized {
		t.Fatalf("GET /me with the old cookie = %d, want 401", me.StatusCode)
	}
}

// TestIntegrationGlobalAdminIsLetIn: the admin bootstrapped from
// [[ env_prefix ]]_ADMIN_SUB, bound only in the global domain, signs in and holds a
// role permission.
func TestIntegrationGlobalAdminIsLetIn(t *testing.T) {
	rig := newIntegrationRig(t)
	res := rig.signIn(t, integrationAdmin)
	s := sessionCookieOf(res)
	if res.StatusCode != http.StatusFound || s == nil || s.MaxAge <= 0 {
		t.Fatalf("admin callback = %d with cookie %v, want 302 and a session", res.StatusCode, s)
	}
	if n := rig.sessionKeys(t); n != 1 {
		t.Fatalf("redis holds %d session keys, want 1", n)
	}
	if me := rig.do(http.MethodGet, "/me", s); me.StatusCode != http.StatusOK {
		t.Fatalf("admin GET /me = %d, want 200", me.StatusCode)
	}
	if p := rig.do(http.MethodGet, "/projects", s); p.StatusCode != http.StatusOK {
		t.Fatalf("admin GET /projects = %d, want 200", p.StatusCode)
	}
}

// TestIntegrationProjectBindingIsScoped: a user bound only in project A
// may sign in, holds a Contributor permission in A, is denied the same
// permission in project B, and, through HTTP, is denied a role route (all
// role routes are decided in the global domain today).
func TestIntegrationProjectBindingIsScoped(t *testing.T) {
	rig := newIntegrationRig(t)
	const sub = "100000000000000000555"
	if _, err := rig.enforcer.AddGroupingPolicy(sub, "Contributor", "proj-a"); err != nil {
		t.Fatal(err)
	}
	for _, c := range []struct {
		project string
		want    bool
	}{{"proj-a", true}, {"proj-b", false}, {db.Global, false}} {
		got, err := db.Authorize(rig.enforcer, sub, c.project, "Projects", "Read")
		if err != nil || got != c.want {
			t.Errorf("Authorize(%s, Projects Read) = %v, %v; want %v", c.project, got, err, c.want)
		}
	}

	res := rig.signIn(t, sub)
	s := sessionCookieOf(res)
	if res.StatusCode != http.StatusFound || s == nil || s.MaxAge <= 0 {
		t.Fatalf("project-bound callback = %d with cookie %v, want 302 and a session", res.StatusCode, s)
	}
	if me := rig.do(http.MethodGet, "/me", s); me.StatusCode != http.StatusOK {
		t.Fatalf("project-bound GET /me = %d, want 200", me.StatusCode)
	}
	if p := rig.do(http.MethodGet, "/projects", s); p.StatusCode != http.StatusForbidden {
		t.Fatalf("project-bound GET /projects (global domain) = %d, want 403", p.StatusCode)
	}
}

// TestIntegrationLogoutEndsSession: signing out over the real Redis store
// deletes the session, clears the cookie with the same flags it was set
// with, and a request carrying the old cookie afterwards is signed out.
func TestIntegrationLogoutEndsSession(t *testing.T) {
	rig := newIntegrationRig(t)
	s := sessionCookieOf(rig.signIn(t, integrationAdmin))
	if s == nil || rig.sessionKeys(t) != 1 {
		t.Fatalf("admin sign-in left cookie %v and %d keys, want a cookie and 1 key", s, rig.sessionKeys(t))
	}
	if me := rig.do(http.MethodGet, "/me", s); me.StatusCode != http.StatusOK {
		t.Fatalf("GET /me before logout = %d, want 200", me.StatusCode)
	}

	out := rig.do(http.MethodPost, LogoutPath, s)
	if out.StatusCode != http.StatusNoContent {
		t.Fatalf("logout = %d, want 204", out.StatusCode)
	}
	c := sessionCookieOf(out)
	if c == nil || c.MaxAge >= 0 || c.Value != "" || !c.HttpOnly || !c.Secure || c.SameSite != http.SameSiteLaxMode || c.Path != "/" {
		t.Fatalf("logout cookie = %+v, want [[ ident ]]_session cleared, HttpOnly, Secure, SameSite=Lax, Path=/", c)
	}
	if n := rig.sessionKeys(t); n != 0 {
		t.Fatalf("redis holds %d session keys after logout, want 0", n)
	}
	if me := rig.do(http.MethodGet, "/me", s); me.StatusCode != http.StatusUnauthorized {
		t.Fatalf("GET /me with the old cookie after logout = %d, want 401", me.StatusCode)
	}
}

// TestIntegrationMeRolesFromBindings: /me reports the roles the user is
// bound to, read from Casbin, not a fixed value. The bootstrapped admin is
// Admin in the global domain; a user bound in two projects gets both.
func TestIntegrationMeRolesFromBindings(t *testing.T) {
	rig := newIntegrationRig(t)
	const sub = "100000000000000000444"
	for _, b := range [][]string{{sub, "Manager", "proj-b"}, {sub, "Contributor", "proj-a"}} {
		if _, err := rig.enforcer.AddGroupingPolicy(b[0], b[1], b[2]); err != nil {
			t.Fatal(err)
		}
	}
	for who, want := range map[string]string{
		integrationAdmin: `[{"role":"Admin","domain":"global"}]`,
		sub:              `[{"role":"Contributor","domain":"proj-a"},{"role":"Manager","domain":"proj-b"}]`,
	} {
		s := sessionCookieOf(rig.signIn(t, who))
		me := rig.do(http.MethodGet, "/me", s)
		if me.StatusCode != http.StatusOK {
			t.Fatalf("GET /me as %s = %d, want 200", who, me.StatusCode)
		}
		var body struct {
			Roles json.RawMessage `json:"roles"`
		}
		if err := json.NewDecoder(me.Body).Decode(&body); err != nil {
			t.Fatal(err)
		}
		if got := string(body.Roles); got != want {
			t.Errorf("GET /me as %s roles = %s, want %s", who, got, want)
		}
	}
}
